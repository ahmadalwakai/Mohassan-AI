# Local preview: copy to .env.local, keep it out of Git. Generate each key using
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WASLA_WEB_ORIGIN=http://127.0.0.1:3017
WASLA_SESSION_KEY=
WASLA_TRANSPORT=direct
WASLA_UPSTREAM_URL=https://127.0.0.1:47622
WASLA_UPSTREAM_PIN=
WASLA_CA_FILE=

# After approval, hosted Vercel mode uses an OUTBOUND worker on Windows.
# Vercel cannot directly reach a private Tailscale address.
# Apply db/relay.sql to a separate Neon database before switching transports.
# WASLA_TRANSPORT=relay
# DATABASE_URL=postgresql://...
# WASLA_RELAY_INSTALLATION_ID=your-installation-id
# WASLA_RELAY_TOKEN=separate-random-secret-at-least-32-characters
# WASLA_RELAY_KEY_BASE64=separate-32-byte-base64-key
