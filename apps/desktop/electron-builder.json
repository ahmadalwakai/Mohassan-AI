{
  "appId": "ai.mohassan.desktop",
  "productName": "Mohassan",
  "copyright": "Mohassan AI",
  "directories": { "output": "release", "buildResources": "assets" },
  "files": ["dist/**/*", "assets/**/*", "package.json"],
  "asar": true,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
    "icon": "assets/icon.ico",
    "artifactName": "Mohassan-Desktop-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mohassan",
    "runAfterFinish": true
  },
  "portable": { "artifactName": "Mohassan-Desktop-Portable-${version}.${ext}" }
}
