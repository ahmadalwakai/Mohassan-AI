{
  "name": "@mohassan/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "description": "تطبيق موحسن لسطح المكتب: يشغّل موحسن على هذا الجهاز ويعرضه في نافذة واحدة مع أيقونة في شريط المهام.",
  "author": "Mohassan AI",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win --config electron-builder.json"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
