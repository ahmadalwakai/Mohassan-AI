# Local development uses a single embedded PostgreSQL owner process.
WEB_ORIGIN=http://127.0.0.1:3000
SERVER_PORT=4000
# Set these in production. Never commit actual values.
DATABASE_URL=
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=
# Web Push contact mailto: address or public HTTPS URL. Empty by default. Push requires all three VAPID settings.
WEB_PUSH_VAPID_SUBJECT=
# Web Push public key. Empty by default. Generate the key pair with apps/server/scripts/generate-vapid-keys.mjs.
WEB_PUSH_VAPID_PUBLIC_KEY=
# Web Push private key. Empty by default. Store the generated key in the server's private environment.
WEB_PUSH_VAPID_PRIVATE_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional Groq prices (USD per million tokens) for the cost estimate. Empty = cost shown as unknown.
GROQ_PRICE_INPUT_PER_MTOK=
GROQ_PRICE_OUTPUT_PER_MTOK=
# Optional self-hosted FreeLLMAPI gateway (https://github.com/tashfeenahmed/freellmapi), assistant chat only.
# The unified key comes from the gateway's Keys page. Plain http is accepted only for localhost.
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
# Comma-separated priority list: auto, auto:fast, auto:smart, auto:reliable, a named chain auto:<name>, or catalog ids.
FREELLMAPI_MODELS=auto
FREELLMAPI_FREE_ONLY=true
FREELLMAPI_TIMEOUT_MS=60000
# Move to the next candidate when one is rate-limited or unavailable.
AI_AUTOMATIC_FALLBACK=true
# Allow a request that started on a free model to continue on paid Groq. Off by default.
AI_ALLOW_PAID_FALLBACK=false
STUDIO_AI_DATA_DIR=.data/studio-ai
# Optional isolated full Next runtime. Empty means initial inert preview only.
STUDIO_GATEWAY_URL=
LEARNING_EVALUATION_MODEL=
LEARNING_EVALUATION_OLLAMA_URL=http://127.0.0.1:11434
STUDIO_GATEWAY_SECRET=
STUDIO_PREVIEW_PORT=5000
# Explicitly enable in production; local pairing and grants are still required.
WINDOWS_REMOTE_ENABLED=false
# Production runs API and worker independently against Neon.
RUN_WORKER=true
# Defaults to true in production and false elsewhere. Set true or false to override.
# PRODUCTION_METRICS_ENABLED=true
# Empty uses production-metrics under STATE_DIRECTORY (systemd), or .data/production-metrics.
PRODUCTION_METRICS_DIR=
# The permanent local model worker starts only when set to 1.
MOHASSAN_MODEL_WORKER=0
# Path to the local model worker configuration, relative to the repository by default.
MOHASSAN_MODEL_WORKER_CONFIG=.data/model-worker.json
# Empty uses .venv-execution/Scripts/python.exe on Windows or .venv-execution/bin/python on Linux.
EXECUTOR_PYTHON=
# Optional disposable loopback PostgreSQL database for the migration test. Empty uses PGlite.
PLATFORM_MIGRATION_TEST_DATABASE_URL=
# Optional Python interpreter for the permanent-worker fixture tests. Empty skips those tests.
MODEL_WORKER_TEST_PYTHON=
# Vercel automatically sets this to 1 on its deployments. Leave it unset locally.
# VERCEL=1
# Loads only explicitly activated, currently inspected skills; does not grant tools or enable executable skills.
SKILL_ENGINE_ENABLED=false
# GitHub skills source: one PUBLIC repository (owner/repo) polled over HTTPS, needs SKILL_ENGINE_ENABLED=true. Empty = off.
SKILL_REMOTE_REPO=
# Branch to follow; always read as refs/heads/<ref>.
SKILL_REMOTE_REF=main
# Folder inside the repository holding one sub-folder per skill (the folder name is the skill id).
SKILL_REMOTE_PATH=skills
# Poll interval in minutes, 5–1440; 0 = manual sync from the library only.
SKILL_REMOTE_SYNC_MINUTES=30
# Activate instruction-only skills that pass inspection with no findings. Everything else waits for your review.
SKILL_REMOTE_AUTO_ACTIVATE=false
# Where the small bare mirror of the repository is kept.
SKILL_REMOTE_DATA_DIR=.data/skills-remote
CODING_DATA_DIR=.data/coding
# Semicolon-separated trusted roots on Windows. Defaults to this workspace.
CODING_ALLOWED_ROOTS=
# Fixed-size quota volumes from scripts/isolation-admin-setup.ps1. Empty keeps executable skills closed.
SANDBOX_QUOTA_ROOT=
# Google Ads API. OAuth web client from Google Cloud; redirect URI: <WEB_ORIGIN>/api/google-ads/oauth/callback. See docs/GOOGLE-ADS.md.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# 32 random bytes in base64. Encrypts the stored refresh token; changing it requires reconnecting.
GOOGLE_ADS_TOKEN_KEY=
# Optional: Google sunset developer tokens on 2026-09-09. Sent only when set.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Stays false until docs/GOOGLE-ADS.md gates pass. Whole currency units per day.
GOOGLE_ADS_PUBLISHING_ENABLED=false
GOOGLE_ADS_MAX_DAILY_BUDGET=100
# Keeps the assistant's sign-ins between tasks. Treat this folder like a password.
BROWSER_PROFILE_DIR=
