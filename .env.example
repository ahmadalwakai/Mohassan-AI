# Local development uses a single embedded PostgreSQL owner process.
WEB_ORIGIN=http://127.0.0.1:3000
SERVER_PORT=4000
# Set these in production. Never commit actual values.
DATABASE_URL=
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
STUDIO_AI_DATA_DIR=.data/studio-ai
# Optional isolated full Next runtime. Empty means initial inert preview only.
STUDIO_GATEWAY_URL=
STUDIO_GATEWAY_SECRET=
STUDIO_PREVIEW_PORT=5000
# Explicitly enable in production; local pairing and grants are still required.
WINDOWS_REMOTE_ENABLED=false
# Production runs API and worker independently against Neon.
RUN_WORKER=true
CODING_DATA_DIR=.data/coding
# Semicolon-separated trusted roots on Windows. Defaults to this workspace.
CODING_ALLOWED_ROOTS=
