# Local development uses a single embedded PostgreSQL owner process.
WEB_ORIGIN=http://127.0.0.1:3000
SERVER_PORT=4000
# Set these in production. Never commit actual values.
DATABASE_URL=
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
STUDIO_AI_DATA_DIR=.data/studio-ai
# Optional isolated full Next runtime. Empty means initial inert preview only.
STUDIO_GATEWAY_URL=
STUDIO_GATEWAY_SECRET=
STUDIO_PREVIEW_PORT=5000
# Explicitly enable in production; local pairing and grants are still required.
WINDOWS_REMOTE_ENABLED=false
# Production runs API and worker independently against Neon.
RUN_WORKER=true
# Loads only explicitly activated, currently inspected skills; does not grant tools or enable executable skills.
SKILL_ENGINE_ENABLED=false
CODING_DATA_DIR=.data/coding
# Semicolon-separated trusted roots on Windows. Defaults to this workspace.
CODING_ALLOWED_ROOTS=
# Fixed-size quota volumes from scripts/isolation-admin-setup.ps1. Empty keeps executable skills closed.
SANDBOX_QUOTA_ROOT=
# Google Ads API. OAuth web client from Google Cloud; redirect URI: <WEB_ORIGIN>/api/google-ads/oauth/callback. See docs/GOOGLE-ADS.md.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# 32 random bytes in base64. Encrypts the stored refresh token; changing it requires reconnecting.
GOOGLE_ADS_TOKEN_KEY=
# Optional: Google sunset developer tokens on 2026-09-09. Sent only when set.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Stays false until docs/GOOGLE-ADS.md gates pass. Whole currency units per day.
GOOGLE_ADS_PUBLISHING_ENABLED=false
GOOGLE_ADS_MAX_DAILY_BUDGET=100
# Keeps the assistant's sign-ins between tasks. Treat this folder like a password.
BROWSER_PROFILE_DIR=
