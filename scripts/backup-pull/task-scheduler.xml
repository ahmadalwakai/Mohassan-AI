<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows Task Scheduler schema, retrieved 2026-11-25.
     https://learn.microsoft.com/windows/win32/taskschd/task-scheduler-schema -->
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Download and verify the newest Mohassan database backup.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-11-25T05:00:00Z</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="BackupOwner">
      <UserId>REPLACE_WITH_OWNER_SID</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT30M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="BackupOwner">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoLogo -NoProfile -NonInteractive -File "REPLACE_WITH_ABSOLUTE_SCRIPT_PATH" -SshAlias "REPLACE_WITH_SSH_ALIAS" -Destination "REPLACE_WITH_PRIVATE_BACKUP_FOLDER"</Arguments>
    </Exec>
  </Actions>
</Task>
