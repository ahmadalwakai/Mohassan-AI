# systemd EnvironmentFile syntax: KEY=value, without export or command substitution.
# Transfer existing secret values privately; leave this example without credentials.
NODE_ENV=production
WEB_ORIGIN=https://www.mohassansy.com
SERVER_HOST=127.0.0.1
SERVER_PORT=4000
DATABASE_URL=
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=
DATA_DIR=/var/lib/mohassan/postgres
CODING_DATA_DIR=/var/lib/mohassan/coding
CODING_ALLOWED_ROOTS=/var/lib/mohassan/coding
STUDIO_AI_DATA_DIR=/var/lib/mohassan/studio-ai
BROWSER_PROFILE_DIR=/var/lib/mohassan/browser-profile
# Staging must not consume tasks from the existing production database.
RUN_WORKER=false
WINDOWS_REMOTE_ENABLED=false
SKILL_ENGINE_ENABLED=false
AI_ALLOW_PAID_FALLBACK=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# A gateway on the Windows computer's localhost is not available on this machine.
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODELS=auto
FREELLMAPI_FREE_ONLY=true
AI_AUTOMATIC_FALLBACK=true
STUDIO_GATEWAY_URL=
STUDIO_GATEWAY_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_TOKEN_KEY=
GOOGLE_ADS_PUBLISHING_ENABLED=false
