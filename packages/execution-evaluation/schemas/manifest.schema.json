{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mohassan:execution-evaluation:manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "status",
    "entries",
    "targets",
    "provenance_reference",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "execution-evaluation-manifest-v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "partial",
        "ready"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task_hash",
          "immutable_task_hash",
          "public_input_hash",
          "task_family",
          "project_family",
          "template_family",
          "tier"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "task_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "immutable_task_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "public_input_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_family": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          },
          "project_family": {
            "type": "string",
            "minLength": 1
          },
          "template_family": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "atomic",
              "repository_context",
              "end_to_end"
            ]
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atomic",
        "repository_context",
        "end_to_end"
      ],
      "properties": {
        "atomic": {
          "type": "integer",
          "minimum": 1
        },
        "repository_context": {
          "type": "integer",
          "minimum": 1
        },
        "end_to_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance_reference": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

