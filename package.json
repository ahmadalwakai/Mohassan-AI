{
  "name": "mohassan-ai",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "zod": "4.6.7"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --production",
    "build": "npm run build --workspace @mohassan/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @mohassan/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ai:check": "tsx scripts/check-ai.ts",
    "coding:check": "tsx scripts/check-coding.ts",
    "assistant:check": "tsx scripts/check-assistant.ts",
    "learning:eval": "tsx scripts/learning-eval.ts",
    "ads:check": "tsx scripts/check-google-ads-api.ts",
    "ads:setup": "tsx scripts/check-google-ads-setup.ts",
    "ads:regress": "tsx scripts/google-ads-regress.ts",
    "db:check": "tsx scripts/check-postgres.ts",
    "sandbox:check": "tsx scripts/probe-sandbox.ts",
    "server": "tsx apps/server/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "owner:create": "tsx apps/server/src/create-owner.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.38.0",
    "@electric-sql/pglite": "0.5.15",
    "@emotion/react": "11.14.0",
    "@fastify/rate-limit": "11.2.2",
    "better-auth": "1.7.17",
    "dotenv": "17.2.3",
    "fastify": "5.12.8",
    "kysely": "0.29.8",
    "lucide-react": "0.548.0",
    "motion": "14.9.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "pg": "8.16.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
